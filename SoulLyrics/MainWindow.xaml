<Window x:Class="SoulLyrics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soul Lyrics" Height="720" Width="1080" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#0D0D12" Foreground="#F7F7FB">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F7F7FB"/>
            <Setter Property="Background" Value="#242430"/>
            <Setter Property="BorderBrush" Value="#353543"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="SOUL LYRICS" FontSize="12" FontWeight="Bold" Foreground="#FF5C9A" CharacterSpacing="180"/>
                <TextBlock Text="Feel every word." FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <TextBlock Text="Your music. Your machine. Your moment." FontSize="13" Foreground="#9292A4" Margin="0,5,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="＋  Open music" Click="OpenMusic_Click" VerticalAlignment="Center" Background="#FF5C9A" BorderBrush="#FF5C9A" Padding="18,12"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#17171F" CornerRadius="22" Padding="24" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="190" Height="190" CornerRadius="24" Background="#24202D" HorizontalAlignment="Center">
                            <Grid>
                                <Ellipse Width="132" Height="132" Stroke="#FF5C9A" StrokeThickness="1.5" Opacity=".75"/>
                                <Ellipse Width="94" Height="94" Stroke="#FF5C9A" StrokeThickness="1" Opacity=".5"/>
                                <Ellipse Width="54" Height="54" Fill="#FF5C9A"/>
                                <Ellipse Width="14" Height="14" Fill="#17171F"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="TrackTitleText" Text="Nothing playing yet" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,24,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TrackPathText" Text="Open a local audio file to begin" FontSize="12" Foreground="#9292A4" TextAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,22,0,0">
                        <Slider x:Name="SeekSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="SeekSlider_ValueChanged" IsMoveToPointEnabled="True"/>
                        <DockPanel Margin="0,3,0,16">
                            <TextBlock x:Name="CurrentTimeText" Text="0:00" Foreground="#9292A4" FontSize="11" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="DurationText" Text="0:00" Foreground="#9292A4" FontSize="11" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="■" Width="48" Click="Stop_Click" Margin="0,0,10,0"/>
                            <Button x:Name="PlayPauseButton" Content="▶  Play" Width="130" Click="PlayPause_Click" Background="#FF5C9A" BorderBrush="#FF5C9A"/>
                            <Button Content="♫  Load lyrics" Click="LoadLyrics_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="#17171F" CornerRadius="22" Padding="26" Margin="14,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="LYRICS" FontSize="11" FontWeight="Bold" Foreground="#FF5C9A" CharacterSpacing="160"/>
                            <TextBlock Text="Stay in the feeling." FontSize="21" FontWeight="SemiBold" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Button Content="↗  Show overlay" DockPanel.Dock="Right" Click="ShowOverlay_Click" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,24,0,18" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LyricsLinesPanel" VerticalAlignment="Center">
                            <TextBlock Text="Your lyrics will appear here." FontSize="22" Foreground="#9292A4" TextAlignment="Center" TextWrapping="Wrap" Margin="8,30"/>
                            <TextBlock Text="Load an .lrc file, or keep one beside your audio file." FontSize="12" Foreground="#666675" TextAlignment="Center" TextWrapping="Wrap" Margin="8,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" x:Name="StatusText" Text="READY  ·  Offline-first" FontSize="11" Foreground="#9292A4"/>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="2,18,2,0">
            <TextBlock Text="SOUL LYRICS  /  LOCAL PLAYER PREVIEW" Foreground="#5F5F70" FontSize="10" CharacterSpacing="100" DockPanel.Dock="Left"/>
            <TextBlock Text="AI alignment is planned for a later phase" Foreground="#5F5F70" FontSize="10" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
